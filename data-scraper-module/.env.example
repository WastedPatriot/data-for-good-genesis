# Data for Earth - Scraper Module Configuration

# Rate Limiting
RATE_LIMIT_SECONDS=2.0
JITTER_SECONDS=0.5

# Output Configuration
OUTPUT_DIR=./output

# Data for Earth API Configuration (for ingestion)
DATAFOREARTH_API_URL=https://fszghwwbvxwkmgfvhzrh.supabase.co/functions/v1/external-ingest
DATAFOREARTH_API_KEY=your_api_key_here
INGEST_SECRET=your_ingest_secret_here

# Optional: Proxy Configuration
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# Logging
LOG_LEVEL=INFO
